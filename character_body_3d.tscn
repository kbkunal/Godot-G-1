[sub_resource type="GDScript" id="GDScript_c7tqt"]
resource_name = "footstep_manager.gd"
script/source = "extends AudioStreamPlayer3D

# Drop footstep AudioStream resources in the Inspector
@export var walk_sounds   : Array[AudioStream] = []
@export var sprint_sounds : Array[AudioStream] = []
@export var land_sounds   : Array[AudioStream] = []

@export var walk_interval   : float = 0.5
@export var sprint_interval : float = 0.3

var _timer    : float = 0.0
var _was_on_floor : bool = true

func _physics_process(delta: float) -> void:
	var player : CharacterBody3D = get_parent()
	var speed   := Vector2(player.velocity.x, player.velocity.z).length()
	var on_floor := player.is_on_floor()

	# Landing thud
	if on_floor and not _was_on_floor and not land_sounds.is_empty():
		_play(land_sounds)
	_was_on_floor = on_floor

	if not on_floor or speed < 0.5:
		_timer = 0.0
		return

	var interval := sprint_interval if speed > 6.0 else walk_interval
	_timer += delta
	if _timer >= interval:
		_timer = 0.0
		var pool := sprint_sounds if speed > 6.0 else walk_sounds
		if not pool.is_empty():
			_play(pool)

func _play(pool: Array[AudioStream]) -> void:
	stream = pool[randi() % pool.size()]
	pitch_scale = randf_range(0.9, 1.1)
	play()
"

