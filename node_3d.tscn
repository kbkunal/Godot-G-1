[sub_resource type="Shader" id="Shader_4xowi"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, unshaded;

// Noise textures — assign these in the Material Inspector
uniform sampler3D noise_tex : filter_linear_mipmap, repeat_enable;
uniform sampler3D detail_tex : filter_linear_mipmap, repeat_enable;

// Cloud controls
uniform float density_threshold : hint_range(0.0, 1.0) = 0.42;
uniform float density_multiplier : hint_range(0.0, 8.0) = 3.5;
uniform float cloud_speed : hint_range(0.0, 0.5) = 0.04;
uniform int march_steps : hint_range(4, 32) = 16;
uniform float step_size : hint_range(0.1, 2.0) = 0.6;

// Lighting
uniform vec3 sun_direction = vec3(0.3, -1.0, 0.5);
uniform vec4 cloud_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform vec4 shadow_color : source_color = vec4(0.55, 0.6, 0.7, 1.0);
uniform float light_absorption : hint_range(0.0, 2.0) = 0.75;

varying vec3 world_pos;
varying vec3 world_cam;

void vertex() {
    world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
    world_cam = (INV_VIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
}

float sample_density(vec3 pos) {
    vec3 uv = pos * 0.018;
    uv.x += TIME * cloud_speed;
    uv.z += TIME * cloud_speed * 0.4;

    float base = texture(noise_tex, uv).r;
    float detail = texture(detail_tex, uv * 3.5).r * 0.25;
    float density = base - detail;

    return max(0.0, density - density_threshold) * density_multiplier;
}

float light_march(vec3 pos) {
    vec3 step = normalize(-sun_direction) * step_size;
    float transmittance = 1.0;
    for (int i = 0; i < 6; i++) {
        pos += step;
        float d = sample_density(pos);
        transmittance *= exp(-d * light_absorption);
    }
    return transmittance;
}

void fragment() {
    vec3 ray_dir = normalize(world_pos - world_cam);
    vec3 ray_pos = world_cam;

    // March through the cloud volume
    float transmittance = 1.0;
    vec3 light_energy = vec3(0.0);
    vec3 step = ray_dir * step_size;

    for (int i = 0; i < march_steps; i++) {
        ray_pos += step;
        float density = sample_density(ray_pos);

        if (density > 0.0) {
            float light = light_march(ray_pos);
            vec3 col = mix(shadow_color.rgb, cloud_color.rgb, light);
            light_energy += col * density * transmittance;
            transmittance *= exp(-density * 0.5);

            if (transmittance < 0.01) break;
        }
    }

    ALBEDO = light_energy;
    ALPHA = 1.0 - transmittance;
}"

